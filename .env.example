# ==============================================================================
# Autonomous Competitive Intelligence Agent Network — Environment Configuration
# ==============================================================================
# Copy this file to .env in your root directory and/or backend/.env and update values.

# ------------------------------------------------------------------------------
# 1. Database Configuration
# ------------------------------------------------------------------------------
# PostgreSQL database connection string (local or cloud PostgreSQL instance e.g. Render/Neon/Supabase)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/competitive_intel

# ------------------------------------------------------------------------------
# 2. Authentication & JWT Security
# ------------------------------------------------================--------------
# Secret key used for signing JWT tokens (generate a strong random secret key in production)
SECRET_KEY=zJ/Nlrsi4l1w60SSFlf8Vkx17CgG83kPRnBJEFR99X97cZsi4OYoDAy5wGarMdg7
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=30

# ------------------------------------------------------------------------------
# 3. LLM Intelligence Provider (OpenRouter / Groq / OpenAI)
# ------------------------------------------------------------------------------
# Provider name: "openrouter" | "groq" | "openai"
LLM_PROVIDER=openrouter
# API Key for OpenRouter / LLM Provider
LLM_API_KEY=sk-or-v1-your-openrouter-key-here

# ------------------------------------------------------------------------------
# 4. Embeddings & Vector Store Configuration
# ------------------------------------------------------------------------------
# HuggingFace Inference API token for free high-quality semantic embeddings (384-dim)
# Get a free token at: https://huggingface.co/settings/tokens
HF_API_TOKEN=hf_your_huggingface_token_here

# Vector store embedding mode:
#   "auto"   → tries HuggingFace API / local SentenceTransformers (384-dim), falls back to hash
#   "hf_api" → uses HuggingFace API embeddings directly
#   "hash"   → instant hash vectorizer (no API, no download)
VECTOR_STORE_MODE=auto

# ------------------------------------------------------------------------------
# 5. Automated Pipeline & Service Auth (n8n / Cron Triggers)
# ------------------------------------------------------------------------------
# Internal API key for service-to-service calls without JWT auth (n8n, cron, automated tasks).
# Set this exact key in your n8n environment as INTERNAL_API_KEY and header X-Internal-Api-Key.
INTERNAL_API_KEY=18fcbd6c74339fd18a3ffba43e3f1629

# ------------------------------------------------------------------------------
# 6. Default Webhook Notifications (Slack / Discord / Teams)
# ------------------------------------------------------------------------------
# System-wide default Webhook URL for executive Slack report notifications.
# Individual users can also configure their own custom webhook URLs in their Profile page.
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/DEFAULT/WEBHOOK
WEBHOOK_URL=https://hooks.slack.com/services/YOUR/DEFAULT/WEBHOOK

# ------------------------------------------------------------------------------
# 7. Backend Base URL Configuration
# ------------------------------------------------------------------------------
# Public backend URL used to generate clickable HTML report links in Slack & email alerts.
BACKEND_URL=http://localhost:8000

# ------------------------------------------------------------------------------
# 8. LangSmith Tracing & Telemetry (Optional)
# ------------------------------------------------------------------------------
# Optional LangSmith agent execution tracing and observability
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=lsv2_pt_your_langsmith_api_key_here
LANGSMITH_PROJECT=competitive-intel

# ------------------------------------------------------------------------------
# 9. Frontend Configuration (used by Vite client)
# ------------------------------------------------------------------------------
# API base URL for the React dashboard
VITE_API_URL=http://localhost:8000
