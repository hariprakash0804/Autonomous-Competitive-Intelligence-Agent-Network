# Backend
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/competitive_intel
SECRET_KEY=change-me-to-a-random-secret-key
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=30

# LLM (OpenRouter free tier) — powers sentiment analysis, pricing extraction, and report generation
LLM_PROVIDER=openrouter
LLM_API_KEY=

# HuggingFace Inference API (free) — for real semantic embeddings without downloading models
# Get a free token at: https://huggingface.co/settings/tokens
HF_API_TOKEN=

# Vector Store embedding mode:
#   "hf_api" → HuggingFace API embeddings (recommended: real semantics, no download, free)
#   "auto"   → tries local SentenceTransformer (15s timeout), falls back to hash
#   "hash"   → instant hash vectorizer (no API, no download, basic quality)
VECTOR_STORE_MODE=hf_api

# LangSmith (optional)
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=competitive-intel

# Internal API Key (for n8n / service-to-service auth without JWT)
# Set this in your n8n environment as INTERNAL_API_KEY to authenticate automated pipeline triggers
INTERNAL_API_KEY=change-me-to-a-random-api-key

# Backend public URL (used in Slack/email report links)
BACKEND_URL=https://your-backend.onrender.com

# Frontend
VITE_API_URL=http://localhost:8000
