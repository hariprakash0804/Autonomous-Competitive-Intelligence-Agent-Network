    {
      "parameters": {
        "jsCode": "// Extract ONLY the single newest report (first item), handling all n8n input modes\nconst allItems = $input.all();\nif (allItems && allItems.length > 0) {\n  const firstData = allItems[0].json;\n  if (Array.isArray(firstData)) {\n    return firstData.length > 0 ? [{ json: firstData[0] }] : [];\n  } else if (firstData && typeof firstData === 'object') {\n    return [{ json: firstData }];\n  }\n}\nreturn [];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
