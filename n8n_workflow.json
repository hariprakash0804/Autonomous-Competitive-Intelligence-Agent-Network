{
  "name": "Weekly Autonomous Competitive Intelligence Pipeline Cron",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "weeks",
              "triggerAtDay": [
                1
              ],
              "triggerAtHour": 9
            }
          ]
        }
      },
      "name": "Weekly Cron Trigger (Mondays 9 AM)",
      "type": "n8n-nodes-base.cron",
      "typeVersion": 1,
      "position": [
        250,
        300
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "http://backend:8000/competitors/",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Internal-Api-Key",
              "value": "={{ $env.INTERNAL_API_KEY }}"
            }
          ]
        },
        "options": {}
      },
      "name": "Fetch Tracked Competitors List",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 2,
      "position": [
        470,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=http://backend:8000/pipeline/run/{{ $json.id }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Internal-Api-Key",
              "value": "={{ $env.INTERNAL_API_KEY }}"
            }
          ]
        },
        "options": {}
      },
      "name": "Trigger Agent Pipeline Run",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 2,
      "position": [
        690,
        300
      ]
    },
    {
      "parameters": {
        "amount": 10,
        "unit": "seconds"
      },
      "name": "Wait for Pipeline Execution",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1,
      "position": [
        910,
        300
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "http://backend:8000/reports/",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Internal-Api-Key",
              "value": "={{ $env.INTERNAL_API_KEY }}"
            }
          ]
        },
        "options": {}
      },
      "name": "Fetch Generated Reports",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 2,
      "position": [
        1130,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=http://backend:8000/reports/deliver-slack/{{ $json[0].id }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Internal-Api-Key",
              "value": "={{ $env.INTERNAL_API_KEY }}"
            }
          ]
        },
        "options": {}
      },
      "name": "Post Latest Report to Slack",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 2,
      "position": [
        1350,
        300
      ]
    }
  ],
  "connections": {
    "Weekly Cron Trigger (Mondays 9 AM)": {
      "main": [
        [
          {
            "node": "Fetch Tracked Competitors List",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch Tracked Competitors List": {
      "main": [
        [
          {
            "node": "Trigger Agent Pipeline Run",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Trigger Agent Pipeline Run": {
      "main": [
        [
          {
            "node": "Wait for Pipeline Execution",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Wait for Pipeline Execution": {
      "main": [
        [
          {
            "node": "Fetch Generated Reports",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch Generated Reports": {
      "main": [
        [
          {
            "node": "Post Latest Report to Slack",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
}
